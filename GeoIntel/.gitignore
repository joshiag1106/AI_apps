out
# SQLite and its sidecars. The WAL holds recently written rows, so committing it
# publishes whatever was last written — including account emails and password hashes.
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.local
# Anything derived from them too. A .env.local.bak carries exactly the same secrets
# as .env.local and was not covered by the two lines above.
.env.*.local
.env.local.*
.env.*.bak
.DS_Store
*.tsbuildinfo
