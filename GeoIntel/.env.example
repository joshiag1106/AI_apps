# All optional. The engine runs fully without any of these.

# Deeper Chinese translation, framing analysis and narrative summaries.
# Absent, the deterministic engine handles everything.
ANTHROPIC_API_KEY=

# Live Stripe billing. Absent, checkout runs in mock mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Session signing secret. A random one is generated per-boot if unset.
SESSION_SECRET=

# Background corpus refresh. Off unless set: a default clone must not start
# fetching 73 live publisher feeds on its own. The interval floor is 15 minutes
# and is not overridable — every cycle hits those feeds for real.
KAUTILYA_AUTO_INGEST=
KAUTILYA_INGEST_MINUTES=30

# Ladder alerts, delivered over SMTP. Without credentials nothing is sent and the
# ingest logs what it would have delivered, so the whole pipeline is exercisable
# without mailing anyone. Alerts are Desk Pro only and off until a reader opts in
# on /account.
#
# SMTP_USER is the full mailbox address, SMTP_PASS its password. Which host you
# want follows from where that address's mail is actually hosted — check its MX
# records rather than guessing from the domain name. Two worked examples:
#   Hostinger  smtp.hostinger.com:465, the mailbox password from hPanel
#   Gmail      smtp.gmail.com:465, and a 16-character App Password from
#              myaccount.google.com/apppasswords, which exists only once 2-Step
#              Verification is on — the ordinary password will not authenticate
# Port 465 is implicit TLS. Port 587 is STARTTLS and is required to upgrade, so a
# password is never sent in the clear either way. SMTP_HOST falls back to Gmail's
# if unset, which is only right if that is genuinely where your mail lives.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Most providers, Gmail included, rewrite From to whichever
# account authenticated rather than refusing a mismatch, so pointing this somewhere
# else mostly buys a header nobody will ever see.
ALERTS_FROM=
# Used to build links in the mail; falls back to localhost.
KAUTILYA_ORIGIN=
