{
  "name": "josh",
  "productName": "Josh",
  "version": "1.0.0",
  "description": "A fast, secure, cross-platform terminal emulator with tabs, split panes and GPU rendering.",
  "license": "MIT",
  "author": "Josh Contributors",
  "homepage": "https://github.com/joshiag1106/AI_apps",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "verify": "node scripts/verify.js",
    "prestart": "node scripts/verify.js",
    "start": "electron .",
    "pretest": "node scripts/verify.js",
    "test": "node --test",
    "icon": "node scripts/make-icon.js",
    "predist": "node scripts/verify.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
